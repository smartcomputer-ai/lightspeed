        "target"
      ],
      "type": "object"
    },
    "TemplateId": {
      "description": "`templateId`: the provider's own id for a template.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "TemplateResources": {
      "additionalProperties": false,
      "description": "Compute a template's targets get, in provider-neutral units. Each\nfield is absent when the provider does not fix it.",
