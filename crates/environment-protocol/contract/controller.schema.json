    "ProtocolError": {
      "additionalProperties": false,
      "description": "A protocol error: one kind, its typed data and a message.\n\nSerializes as an `ErrorObject`. Displays as `{kind}: {message}`.",
      "properties": {
        "code": {
          "description": "Fixed by `data.kind`; see `ProtocolErrorKind::code`.",
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "$ref": "#/definitions/ErrorData"
        },
        "message": {
          "description": "Human-readable description. Never parsed.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "type": "object"
    },
    "ProviderNativeRef": {
      "description": "`sourceTarget` of `target/adopt`: a provider-native reference to an\nexisting target, in a format the provider defines.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "ProviderTargetId": {
      "description": "`targetId`: the provider's own id for a target, opaque to Lightspeed.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "PublicUrl": {
      "description": "A public `http://` or `https://` URL a provider reports, such as a\ntarget's ingress `endpoint`: lowercase scheme, a host and optional port,\noptional path and query, no user information or fragment, at most 2048\nbytes. Validated on decode.",
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https?://[^/?#@\\s]+([/?][^#\\s]*)?$",
      "type": "string"
    },
    "RemoveIngressParams": {
      "additionalProperties": false,
      "description": "`ingress/remove` params: stop routing public ingress to the target.\nIdempotent.",
      "properties": {
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "SetTargetPowerParams": {
      "additionalProperties": false,
      "description": "`target/setPower` params: converge the target toward `power`. A target\nalready in, or moving toward, that state is observed without further\naction. Resuming may replace the underlying host process. A target whose\n`phase` is not `active` is `failedPrecondition` (`targetNotActive`); a\nstate outside `supportedPowerStates` is `invalidParams`.",
      "properties": {
        "power": {
          "allOf": [
            {
              "$ref": "#/definitions/PowerState"
            }
          ],
          "description": "One of the target's `supportedPowerStates`."
        },
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target",
        "power"
      ],
      "type": "object"
    },
    "TargetObservation": {
      "additionalProperties": false,
      "description": "What the provider observes about a target. Every target method answers\nwith one.",
      "properties": {
        "displayName": {
          "anyOf": [
            {
              "$ref": "#/definitions/DisplayName"
            }
          ]
        },
        "ingress": {
          "anyOf": [
            {
              "$ref": "#/definitions/IngressObservation"
            }
          ],
          "description": "Public ingress as realized; absent when disabled."
        },
        "metadata": {
          "allOf": [
            {
              "$ref": "#/definitions/Metadata"
            }
          ],
          "description": "Provider-specific display facts."
        },
        "owner": {
          "allOf": [
            {
              "$ref": "#/definitions/TargetOwner"
            }
          ],
          "description": "Echoed from the request."
        },
        "state": {
          "$ref": "#/definitions/TargetState"
        },
        "supportedPowerStates": {
          "description": "Power states `target/setPower` can move this target to. Empty when\nthe provider offers no power control beyond create and close.",
          "items": {
            "$ref": "#/definitions/PowerState"
          },
          "type": "array"
        },
        "targetId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderTargetId"
            }
          ],
          "description": "The provider's id for the target. Absent in two cases only: while\n`phase` is `provisioning` and the provider has not assigned an id\nyet (an asynchronous create answers before it has one; the runtime\nrecords the id from the first observation that carries it), and in a\n`closed` observation of an owner the provider holds no target for."
        }
      },
      "required": [
        "owner",
        "state"
      ],
      "type": "object"
    },
    "TargetOwner": {
      "additionalProperties": false,
      "description": "The Lightspeed incarnation a target belongs to. A provider owns at most\none target per owner.",
      "properties": {
        "bindingId": {
          "$ref": "#/definitions/BindingId"
        },
        "environmentId": {
          "$ref": "#/definitions/EnvironmentId"
        },
        "incarnationId": {
          "$ref": "#/definitions/IncarnationId"
        },
        "universeId": {
          "$ref": "#/definitions/UniverseId"
        }
      },
      "required": [
        "universeId",
        "bindingId",
        "environmentId",
        "incarnationId"
      ],
      "type": "object"
    },
    "TargetPhase": {
      "description": "Lifecycle phase of a target.",
      "oneOf": [
        {
          "const": "provisioning",
          "description": "Being created; not yet usable.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Exists; see `power`.",
          "type": "string"
        },
        {
          "const": "closing",
          "description": "Being destroyed.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "Gone, and nothing of it remains.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Broken beyond the provider's own recovery; see `message`.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The provider cannot tell; see `message`.",
          "type": "string"
        }
      ]
    },
    "TargetRef": {
      "additionalProperties": false,
      "description": "A reference to an existing target: its owner and, once known, its id.\nWithout `targetId` the provider resolves the owner's target itself.",
      "properties": {
        "owner": {
          "$ref": "#/definitions/TargetOwner"
        },
        "targetId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderTargetId"
            }
          ]
        }
      },
      "required": [
        "owner"
      ],
      "type": "object"
    },
    "TargetResponse": {
      "additionalProperties": false,
      "description": "Response of every target method and both ingress methods.",
      "properties": {
        "target": {
          "$ref": "#/definitions/TargetObservation"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "TargetState": {
      "additionalProperties": false,
      "description": "A target's state on two axes: lifecycle `phase`, and `power` while\nactive.",
      "properties": {
        "daemonReady": {
          "description": "envd answers on the target's data route (running targets only).",
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/definitions/DescriptiveText"
            }
          ],
          "description": "Why the target is `failed` or `unknown`, or what a transition waits\nfor. Providers build it with\n`DescriptiveText::lossy` from whatever their backend reports."
        },
        "phase": {
          "$ref": "#/definitions/TargetPhase"
        },
        "power": {
          "anyOf": [
            {
              "$ref": "#/definitions/PowerState"
            }
          ],
          "description": "Present exactly when `phase` is `active`."
        }
      },
      "required": [
        "phase"
      ],
      "type": "object"
    },
    "TemplateId": {
      "description": "`templateId`: the provider's own id for a template.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "TemplateResources": {
      "additionalProperties": false,
      "description": "Compute a template's targets get, in provider-neutral units. Each\nfield is absent when the provider does not fix it.",
      "properties": {
        "diskBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memoryBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "vcpus": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "UniverseId": {
      "description": "`universeId` of a Lightspeed universe.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "description": "Every wire type of the controller plane, protocol version 3.",
  "title": "Lightspeed environment controller plane"
}
