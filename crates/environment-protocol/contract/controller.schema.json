    "ProviderTargetId": {
      "description": "`targetId`: the provider's own id for a target, opaque to Lightspeed.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "PublicUrl": {
      "description": "A public `http://` or `https://` URL a provider reports, such as a\ntarget's ingress `endpoint`: lowercase scheme, a host and optional port,\noptional path and query, no user information or fragment, at most 2048\nbytes. Validated on decode.",
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https?://[^/?#@\\s]+([/?][^#\\s]*)?$",
      "type": "string"
    },
    "RemoveIngressParams": {
      "additionalProperties": false,
      "description": "`ingress/remove` params: stop routing public ingress to the target.\nIdempotent.",
      "properties": {
