          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "SetTargetPowerParams": {
      "additionalProperties": false,
      "description": "`target/setPower` params: move the target to `power`. Requires\n`capabilities.power`. A target already in, or moving toward, that state\nis observed without further action. Resuming may replace the underlying\nhost process. A state outside the template's `powerStates` is\n`invalidParams`; a target whose `phase` is not `active` is\n`failedPrecondition` (`targetNotActive`). The provider stays the owner\nof power afterwards: its own idle policy may move the target again.",
      "properties": {
        "power": {
          "allOf": [
            {
              "$ref": "#/definitions/PowerState"
            }
          ],
          "description": "One of the template's `powerStates`."
        },
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target",
        "power"
      ],
      "type": "object"
    },
    "TargetObservation": {
      "additionalProperties": false,
      "description": "What the provider observes about a target. Every target and ingress\nmethod answers with one; Lightspeed records it for display only.",
      "properties": {
        "ingress": {
          "anyOf": [
            {
              "$ref": "#/definitions/IngressObservation"
            }
          ],
          "description": "Public ingress as realized; absent when disabled."
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/definitions/DescriptiveText"
            }
          ],
          "description": "Why the target is `failed` or `unknown`, or what a transition waits\nfor. Providers build it with `DescriptiveText::lossy` from\nwhatever their backend reports."
        },
        "owner": {
          "allOf": [
            {
              "$ref": "#/definitions/TargetOwner"
            }
          ],
          "description": "Echoed from the request."
        },
        "phase": {
          "$ref": "#/definitions/TargetPhase"
        },
        "power": {
          "anyOf": [
            {
              "$ref": "#/definitions/PowerState"
            }
          ],
          "description": "Present exactly when `phase` is `active`."
        },
        "targetId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderTargetId"
            }
          ],
          "description": "The provider's id for the target. Absent in two cases only: while\n`phase` is `provisioning` and the provider has not assigned an id\nyet (an asynchronous create answers before it has one; the runtime\nrecords the id from the first observation that carries it), and in a\n`closed` observation of an owner the provider holds no target for."
        }
      },
      "required": [
        "owner",
        "phase"
      ],
      "type": "object"
    },
    "TargetOwner": {
      "additionalProperties": false,
      "description": "The Lightspeed environment a target belongs to. A provider owns at most\none target per owner.",
