{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AbortReason": {
      "description": "Why an operation was `aborted`.",
      "oneOf": [
        {
          "const": "cancelled",
          "description": "`$/cancelRequest` named the request.",
          "type": "string"
        },
        {
          "const": "sourceChanged",
          "description": "A file or directory changed while it was being read.",
          "type": "string"
        }
      ]
    },
    "BusyReason": {
      "description": "What limit a `busy` request hit.",
      "oneOf": [
        {
          "const": "requestLimit",
          "description": "The connection's concurrent request limit.",
          "type": "string"
        },
        {
          "const": "transferCapacity",
          "description": "The daemon's limit on active transfer operations.",
          "type": "string"
        },
        {
          "const": "rateLimited",
          "description": "A rate limit on the caller's identity.",
          "type": "string"
        },
        {
          "const": "capacityExhausted",
          "description": "A registration key's limit on active environments.",
          "type": "string"
        }
      ]
    },
    "Capability": {
      "description": "A capability a request needed and the endpoint lacks.",
      "oneOf": [
        {
          "const": "filesystem",
          "description": "The `filesystem` family.",
          "type": "string"
        },
        {
          "const": "filesystemWrite",
          "description": "`capabilities.filesystem.write`: the filesystem is writable.",
          "type": "string"
        },
        {
          "const": "process",
          "description": "The `process` family.",
          "type": "string"
        },
        {
          "const": "processPty",
          "description": "`capabilities.process.pty`.",
          "type": "string"
        },
        {
          "const": "job",
          "description": "The `job` family.",
          "type": "string"
        },
        {
          "const": "power",
          "description": "The controller's `power` capability.",
          "type": "string"
        },
        {
          "const": "ingress",
          "description": "The controller's `ingress` capability.",
          "type": "string"
        }
      ]
    },
    "CloseTargetParams": {
      "additionalProperties": false,
      "description": "`target/close` params: destroy the owner's target and every resource it\nholds, public ingress included. Idempotent. Graceful within the\nprovider's own bound, then forced. Answers `closing` until the target is\ngone, then `closed`; `closed` also when the provider holds no target for\nthe owner.",
      "properties": {
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "ControllerCapabilities": {
      "additionalProperties": false,
      "description": "Optional controller methods. Calling an absent one is\n`capabilityUnavailable`.",
      "properties": {
        "ingress": {
          "description": "`ingress/ensure` and `ingress/remove` are served.",
          "type": "boolean"
        },
        "power": {
          "description": "`target/setPower` is served.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ControllerInitializeParams": {
      "additionalProperties": false,
      "description": "`initialize` params on the controller plane.",
      "properties": {
        "clientInfo": {
          "$ref": "#/definitions/ImplementationInfo"
        },
        "protocolVersion": {
          "description": "The client's `CONTROLLER_PROTOCOL_VERSION`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "clientInfo"
      ],
      "type": "object"
    },
    "ControllerInitializeResponse": {
      "additionalProperties": false,
      "description": "`initialize` response on the controller plane.",
      "properties": {
        "capabilities": {
          "$ref": "#/definitions/ControllerCapabilities"
        },
        "plane": {
          "allOf": [
            {
              "$ref": "#/definitions/Plane"
            }
          ],
          "description": "Always `controller`."
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "serverInfo": {
          "$ref": "#/definitions/ImplementationInfo"
        }
      },
      "required": [
        "protocolVersion",
        "plane",
        "serverInfo",
        "capabilities"
      ],
      "type": "object"
    },
    "CreateTargetParams": {
      "additionalProperties": false,
      "description": "`target/create` params. Idempotent per owner: when the owner already\nhas a target, the provider returns its observation and applies no\ncreation policy (template deprecation, image checks). Handing out a\ntarget from a warm pool counts as a create.",
      "properties": {
        "displayName": {
          "anyOf": [
            {
              "$ref": "#/definitions/DisplayName"
            }
          ],
          "description": "Label for the target, where the provider shows one."
        },
        "idle": {
          "anyOf": [
            {
              "$ref": "#/definitions/IdlePolicy"
            }
          ],
          "description": "Overrides the template's `idle` for this target. A policy that does\nnot validate (`IdlePolicy::validate`) is `invalidParams`."
        },
        "owner": {
          "$ref": "#/definitions/TargetOwner"
        },
        "templateId": {
          "$ref": "#/definitions/TemplateId"
        }
      },
      "required": [
        "owner",
        "templateId"
      ],
      "type": "object"
    },
    "DataRouteRefusal": {
      "description": "Body of the HTTP refusal a data route answers instead of upgrading, with\n`Content-Type: application/json`. A provider data route uses `waking`,\n`booting`, `gone` and `failed`; the gateway's worker route adds\n`provisioning`, `disconnected` and `away` and forwards a provider's\nrefusal unchanged. Every 503 carries `Retry-After` in whole seconds,\n1 to `RETRY_AFTER_MAX_SECS`.\nThe body is an HTTP refusal, not a JSON-RPC message, and is tagged by\n`state`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "503: resuming from a powered-down state.",
          "properties": {
            "state": {
              "const": "waking",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "503: running, envd not answering yet.",
          "properties": {
            "state": {
              "const": "booting",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "503 (gateway): the environment is still provisioning.",
          "properties": {
            "state": {
              "const": "provisioning",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "503 (gateway): the registered daemon is not connected.",
          "properties": {
            "state": {
              "const": "disconnected",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "410 (gateway): the registered daemon has been away past its\nreconnect bound.",
          "properties": {
            "state": {
              "const": "away",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "410: the target no longer exists.",
          "properties": {
            "state": {
              "const": "gone",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "409: broken beyond the provider's recovery.",
          "properties": {
            "message": {
              "$ref": "#/definitions/DescriptiveText"
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "DescriptiveText": {
      "description": "A short human-readable text: 1 to 1024 bytes without control characters\nother than line feed and tab. Never parsed.",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "DisplayName": {
      "description": "A display name: 1 to 128 bytes without control characters.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "type": "string"
    },
    "EnsureIngressParams": {
      "additionalProperties": false,
      "description": "`ingress/ensure` params: route the template's public ingress to the\ntarget. Idempotent. A target whose template has no `publicIngress` is\n`failedPrecondition` (`ingressUnsupported`).",
      "properties": {
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "EnvironmentId": {
      "description": "`environmentId` of a Lightspeed environment.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "EnvironmentTemplate": {
      "additionalProperties": false,
      "description": "A template targets are created from.",
      "properties": {
        "deprecated": {
          "description": "Creates no new targets; existing targets keep working.",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/DescriptiveText"
            }
          ]
        },
        "displayName": {
          "$ref": "#/definitions/DisplayName"
        },
        "idle": {
          "anyOf": [
            {
              "$ref": "#/definitions/IdlePolicy"
            }
          ],
          "description": "Idle policy targets get when `target/create` names none; absent when\nthe provider applies none by default."
        },
        "metadata": {
          "allOf": [
            {
              "$ref": "#/definitions/Metadata"
            }
          ],
          "description": "Provider-specific display facts, such as an image fingerprint."
        },
        "powerStates": {
          "description": "Power states `target/setPower` can move this template's targets to.\nEmpty when the provider offers no power control beyond create and\nclose.",
          "items": {
            "$ref": "#/definitions/PowerState"
          },
          "type": "array"
        },
        "publicIngress": {
          "description": "Targets of this template can serve public ingress.",
          "type": "boolean"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/definitions/TemplateResources"
            }
          ]
        },
        "templateId": {
          "$ref": "#/definitions/TemplateId"
        }
      },
      "required": [
        "templateId",
        "displayName"
      ],
      "type": "object"
    },
    "ErrorData": {
      "description": "The `data` member of an error object: the kind and its typed fields.\n\nKinds without fields are empty struct variants rather than unit\nvariants: serde does not apply `deny_unknown_fields` to the unit\nvariants of an internally tagged enum, and every kind must refuse\nunknown members.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "parseError",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "invalidRequest",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "methodNotFound",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ceiling": {
              "description": "The advertised ceiling the value exceeded.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "field": {
              "description": "Wire path of the offending field, such as `limits.maxDurationMs`.",
              "type": "string"
            },
            "kind": {
              "const": "invalidParams",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notInitialized",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expected": {
              "description": "The version of the peer that sent this error.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "versionMismatch",
              "type": "string"
            },
            "received": {
              "description": "The version the requester stated.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "expected",
            "received"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "notFound",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/NotFoundReason"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "alreadyExists",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "failedPrecondition",
              "type": "string"
            },
            "reason": {
              "$ref": "#/definitions/PreconditionReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "permissionDenied",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/PermissionReason"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capability": {
              "$ref": "#/definitions/Capability"
            },
            "kind": {
              "const": "capabilityUnavailable",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "capability"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "busy",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/BusyReason"
                }
              ]
            },
            "retryAfterMs": {
              "description": "Earliest useful retry, when the server knows it.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "deadlineExceeded",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aborted",
              "type": "string"
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AbortReason"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "payloadTooLarge",
              "type": "string"
            },
            "limitBytes": {
              "description": "The byte limit the payload exceeded.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "limitEntries": {
              "description": "The entry-count limit the result exceeded.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "processFailed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            },
            "retryAfterMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "internal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "GetTargetParams": {
      "additionalProperties": false,
      "description": "`target/get` params. A pure read: it never creates or changes anything.\nA target that no longer exists is `notFound`.",
      "properties": {
        "target": {
          "$ref": "#/definitions/TargetRef"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    },
    "IdlePolicy": {
      "additionalProperties": false,
      "description": "Staged idle policy. Each set threshold is measured against envd\n`env/getIdle` `idleForMs`, and the set thresholds are non-decreasing in\nthe order pause → suspend → stop → close. Every stage is optional; a\npolicy sets at least one.",
      "properties": {
        "closeAfterMs": {
          "description": "Close the target after this long idle; the provider then reports it\n`closed`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pauseAfterMs": {
          "description": "Pause the target after this long idle.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stopAfterMs": {
          "description": "Stop the target after this long idle.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "suspendAfterMs": {
          "description": "Suspend the target after this long idle.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ImplementationInfo": {
      "additionalProperties": false,
      "description": "What a peer says about its own build: `clientInfo`, `serverInfo` and a\ndaemon's registration `implementation`. Descriptive only; the protocol\nversion alone decides whether two peers can talk, and nothing here\nselects, authenticates or gates. Every field is 1 to 256 bytes without control characters,\nchecked on decode and by every constructor, so a value that would be\nrefused can never be built or sent.",
      "properties": {
        "gitSha": {
          "description": "Full or abbreviated git commit of the build.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "type": "string"
        },
        "name": {
          "description": "Product name, such as `lightspeed-envd`.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "type": "string"
        },
        "target": {
          "description": "Rust target triple of the build.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "type": "string"
        },
        "version": {
          "description": "Release version, such as `0.5.0`.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "IngressObservation": {
      "additionalProperties": false,
      "description": "Realized public ingress of a target.",
      "properties": {
        "endpoint": {
          "allOf": [
            {
              "$ref": "#/definitions/PublicUrl"
            }
          ],
          "description": "Public URL that reaches the target's application."
        }
      },
      "required": [
        "endpoint"
      ],
      "type": "object"
    },
    "ListTemplatesParams": {
      "additionalProperties": false,
      "description": "`template/list` params: the universe whose targets the templates would\ncreate. A provider may offer each universe a different set.",
      "properties": {
        "universeId": {
          "$ref": "#/definitions/UniverseId"
        }
      },
      "required": [
        "universeId"
      ],
      "type": "object"
    },
    "ListTemplatesResponse": {
      "additionalProperties": false,
      "description": "`template/list` response.",
      "properties": {
        "templates": {
          "items": {
            "$ref": "#/definitions/EnvironmentTemplate"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
        "type": "string"
      },
      "description": "Descriptive key-value metadata: at most 32 entries, keys 1 to 64 bytes outside the reserved `lightspeed.` prefix, values 1 to 256 bytes, no control characters.",
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "not": {
          "pattern": "^lightspeed\\."
        },
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
      },
      "type": "object"
    },
    "NotFoundReason": {
      "description": "Why a handle, path or identity was not found.",
      "oneOf": [
        {
          "const": "expired",
          "description": "Its retention window ended; a tombstone remembers it.",
          "type": "string"
        },
        {
          "const": "daemonRestarted",
          "description": "It belonged to an earlier daemon instance (see `daemonInstanceId`).",
          "type": "string"
        },
        {
          "const": "unknownDaemon",
          "description": "A daemon identity the gateway has never admitted presented no\nregistration key.",
          "type": "string"
        }
      ]
    },
    "PermissionReason": {
      "description": "Why a `permissionDenied` request was refused.",
      "oneOf": [
        {
          "const": "outsideRoot",
          "description": "The path, or a symlink it passes through, resolves outside the\ndaemon's filesystem root.",
          "type": "string"
        },
        {
          "const": "daemonState",
          "description": "The path names or contains the daemon's state directory.",
          "type": "string"
        },
        {
          "const": "filePermission",
          "description": "The operating system refused access.",
          "type": "string"
        },
        {
          "const": "invalidSignature",
          "description": "The registration signature does not verify.",
          "type": "string"
        },
        {
          "const": "invalidRegistrationKey",
          "description": "The registration key is unknown.",
          "type": "string"
        },
        {
          "const": "registrationKeyRevoked",
          "description": "The registration key was revoked.",
          "type": "string"
        }
      ]
    },
    "Plane": {
      "description": "The plane a connection serves. Each `initialize` response names its\nplane, so a client that reached the wrong socket fails at the handshake.",
      "oneOf": [
        {
