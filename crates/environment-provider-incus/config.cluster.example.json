{
  "controllerListen": "127.0.0.1:19090",
  "incus": {
    "mode": "cluster",
    "endpoints": [
      "https://incus-a.example.ts.net:8443",
      "https://incus-b.example.ts.net:8443",
      "https://incus-c.example.ts.net:8443"
    ],
    "clientCertificatePem": "/run/secrets/incus-client.crt",
    "clientPrivateKeyPem": "/run/secrets/incus-client.key",
    "serverCaPem": "/run/secrets/incus-cluster-ca.crt",
    "storagePool": "default",
    "clusterNetworkUplink": "UPLINK",
    "imageServerUrl": "https://image-builder.example.ts.net:8443"
  },
  "relayIdleSeconds": 60,
  "dialTimeoutSeconds": 10,
  "envdPort": 19091,
  "ingress": {
    "publicBaseUrl": "https://env.example.com",
    "listen": "127.0.0.1:19092"
  },
  "bindings": [
    {
      "universeId": "00000000-0000-0000-0000-000000000001",
      "bindingId": "primary",
      "ipv4Cidr": "10.210.1.1/24",
      "deniedEgressCidrs": ["100.64.0.0/10", "10.0.0.0/8"],
      "maxEnvironments": 10,
      "templates": [
        {
          "templateId": "dev-small-x86-v1",
          "displayName": "Small x86 development VM",
          "description": "2 vCPU, 4 GiB RAM, 40 GiB disk",
          "imageFingerprint": "replace-with-immutable-sha256-fingerprint",
          "cpu": 2,
          "memory": "4GiB",
          "disk": "40GiB",
          "clusterGroup": "x86-production",
          "publicIngress": true,
          "ingressPort": 8080
        }
      ]
    }
  ]
}
