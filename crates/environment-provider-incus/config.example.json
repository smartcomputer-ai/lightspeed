{
  "controllerListen": "127.0.0.1:19090",
  "controllerToken": "replace-with-a-random-deployment-secret",
  "daemonTokenKey": "replace-with-an-independent-random-provider-secret",
  "incus": {
    "baseUrl": "https://hz02.example.ts.net:8443",
    "clientCertificatePem": "/run/secrets/incus-client.crt",
    "clientPrivateKeyPem": "/run/secrets/incus-client.key",
    "serverCaPem": "/run/secrets/incus-server-ca.crt",
    "storagePool": "default",
    "imageServerUrl": "https://hz01-image-builder.example.ts.net:8443"
  },
  "relayIdleSeconds": 60,
  "dialTimeoutSeconds": 10,
  "envdPort": 19091,
  "bindings": [
    {
      "universeId": "00000000-0000-0000-0000-000000000001",
      "bindingId": "primary",
      "ipv4Cidr": "10.210.1.1/24",
      "deniedEgressCidrs": ["100.64.0.0/10", "10.0.0.0/8"],
      "maxEnvironments": 10,
      "templates": [
        {
          "templateId": "dev-small-v1",
          "displayName": "Small development VM",
          "description": "2 vCPU, 4 GiB RAM, 40 GiB disk",
          "imageFingerprint": "replace-with-immutable-sha256-fingerprint",
          "cpu": 2,
          "memory": "4GiB",
          "disk": "40GiB"
        }
      ]
    }
  ]
}
