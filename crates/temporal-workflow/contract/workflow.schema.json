{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Attribution": {
      "description": "Who created a resource or authored bytes. An actor is whatever a key\nallowed to assert one said; core compares it and never resolves it.",
      "oneOf": [
        {
          "description": "The actor a key asserted for its request.",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "actor",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A key acting for itself, named by its display prefix.",
          "properties": {
            "kind": {
              "const": "key",
              "type": "string"
            },
            "prefix": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "prefix"
          ],
          "type": "object"
        },
        {
          "description": "An unauthenticated local development request, or an in-process call.",
          "properties": {
            "kind": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The runtime's own work: a bot, a delegated session, a registration,\nor host administration through the server CLI.",
          "properties": {
            "cause": {
              "type": "string"
            },
            "component": {
              "type": "string"
            },
            "kind": {
              "const": "internal",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "component",
            "cause"
          ],
          "type": "object"
        }
      ]
    },
    "BotId": {
      "type": "string"
    },
    "BotTriggerId": {
      "type": "string"
    },
    "ChannelAccountId": {
      "type": "string"
    },
    "ChannelDeliveryCommand": {
      "description": "One connector activity call. `idempotency_key` is the invocation id, or\n`{invocation}:chunk:{i}/{n}` for a chunk of a split send.",
      "properties": {
        "idempotencyKey": {
          "type": "string"
        },
        "invocationId": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/definitions/ChannelDeliveryOperation"
        },
        "route": {
          "$ref": "#/definitions/ChannelRoute"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "invocationId",
        "idempotencyKey",
        "route",
        "operation"
      ],
      "type": "object"
    },
    "ChannelDeliveryOperation": {
      "description": "What a connector executes: provider message ids and their direction.",
      "oneOf": [
        {
          "properties": {
            "replyContext": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReplyContext"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replyTo": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "send",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "messageId": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "edit",
              "type": "string"
            }
          },
          "required": [
            "type",
            "messageId",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "emoji": {
              "type": "string"
            },
            "fromMe": {
              "description": "Whether the reacted-to message is the bot's own.",
              "type": "boolean"
            },
            "messageId": {
              "type": "string"
            },
            "type": {
              "const": "react",
              "type": "string"
            }
          },
          "required": [
            "type",
            "messageId",
            "emoji",
            "fromMe"
          ],
          "type": "object"
        }
      ]
    },
    "ChannelDeliveryResult": {
      "properties": {
        "messageIds": {
          "description": "Every provider id the delivery produced (a chunked send has several;\nthe first is the anchor).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provider": {
          "$ref": "#/definitions/ChannelProvider"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "provider",
        "messageIds"
      ],
      "type": "object"
    },
    "ChannelInboundMedia": {
      "description": "A provider-owned attachment reference; never bytes. The connector\ndownloads it when the conversation workflow asks (`prepare_channel_media`).",
      "properties": {
        "byteSize": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fileId": {
          "description": "Provider file handle (a Telegram file id, a sealed WhatsApp locator).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ChannelMediaKind"
        },
        "mime": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fileId",
        "kind",
        "mime"
      ],
      "type": "object"
    },
    "ChannelMediaKind": {
      "enum": [
        "image",
        "audio",
        "document"
      ],
      "type": "string"
    },
    "ChannelProvider": {
      "type": "string"
    },
    "ChannelRoute": {
      "description": "Where a delivery goes: one account's chat, optionally a thread.",
      "properties": {
        "accountId": {
          "$ref": "#/definitions/ChannelAccountId"
        },
        "chatId": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/ChannelProvider"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "accountId",
        "chatId"
      ],
      "type": "object"
    },
    "ChatAccess": {
      "description": "Who may take a turn and who may issue control commands, by provider\nhandle (Telegram user id, WhatsApp JID). Handle allowlists on the\ntrigger replace any platform membership lookup.",
      "properties": {
        "allowed": {
          "description": "Handles allowed to take a turn when `turn` is `listed`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "controllers": {
          "description": "Handles allowed to issue `/activation` and `/status`; empty denies\ncontrol commands to everyone.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turn": {
          "allOf": [
            {
              "$ref": "#/definitions/ChatTurnAccess"
            }
          ],
          "default": "anyone"
        }
      },
      "type": "object"
    },
    "ChatActivation": {
      "description": "When the bot acts in a conversation.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChatGroupActivation"
            },
            {
              "type": "null"
            }
          ]
        },
        "mentionNames": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "triggerPrefixes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ChatGroupActivation": {
      "oneOf": [
        {
          "const": "mention",
          "description": "Act on mentions, replies to the bot, and trigger prefixes only.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "Act on every message.",
          "type": "string"
        }
      ]
    },
    "ChatScope": {
      "enum": [
        "direct",
        "group"
      ],
      "type": "string"
    },
    "ChatTurnAccess": {
      "oneOf": [
        {
          "const": "anyone",
          "description": "Anyone in the conversation may take a turn.",
          "type": "string"
        },
        {
          "const": "listed",
          "description": "Only the listed provider handles may take a turn.",
          "type": "string"
        }
      ]
    },
    "ContentRef": {
      "description": "Durable content identity and encoding. The payload stays in CAS; consumers\nproject it outside the engine rather than assuming every output is text.",
      "properties": {
        "content_ref": {
          "type": "string"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_kind": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content_ref"
      ],
      "type": "object"
    },
    "ConversationRef": {
      "description": "The conversation a message belongs to: one account's chat, optionally\na thread inside it.",
      "properties": {
        "accountId": {
          "$ref": "#/definitions/ChannelAccountId"
        },
        "chatId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "accountId",
        "chatId"
      ],
      "type": "object"
    },
    "ConversationStart": {
      "description": "Secret-free durable input of one conversation workflow: the chat trigger\nit serves and the conversation it fronts. The workflow owns nothing on\nthe core side: the bot controller creates and controls the session; the\nworkflow is the source of the conversation's events and the receiver of\nits `message_*` tools.",
      "properties": {
        "access": {
          "$ref": "#/definitions/ChatAccess"
        },
        "accountId": {
          "$ref": "#/definitions/ChannelAccountId"
        },
        "activation": {
          "$ref": "#/definitions/ChatActivation"
        },
        "botId": {
          "$ref": "#/definitions/BotId"
        },
        "connectorTaskQueue": {
          "description": "Task queue of the connector host serving the account.",
          "type": "string"
        },
        "conversation": {
          "$ref": "#/definitions/ConversationRef"
        },
        "label": {
          "description": "Human label of the conversation (routed session label, display name).",
          "type": "string"
        },
        "provider": {
          "$ref": "#/definitions/ChannelProvider"
        },
        "scope": {
          "$ref": "#/definitions/ChatScope"
        },
        "triggerId": {
          "$ref": "#/definitions/BotTriggerId"
        },
        "universeId": {
          "type": "string"
        }
      },
      "required": [
        "universeId",
        "botId",
        "triggerId",
        "accountId",
        "provider",
        "conversation",
        "scope",
        "activation",
        "access",
        "label",
        "connectorTaskQueue"
      ],
      "type": "object"
    },
    "EmissionBody": {
      "description": "Closed internal vocabulary carried by the shared delivery signal.\n\nWorkflow-tool invocation bodies join this enum when the durable tool\ncontracts land. This first slice folds the two existing transports.",
      "oneOf": [
        {
          "properties": {
            "failure_message_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "run_terminal",
              "type": "string"
            },
            "output": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ContentRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run_id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "status": {
              "$ref": "#/definitions/RunStatus"
            },
            "token": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "token",
            "run_id",
            "status"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "source_resolution",
              "type": "string"
            },
            "promise_id": {
              "$ref": "#/definitions/PromiseId"
            },
            "resolution": {
              "$ref": "#/definitions/PromiseResolution"
            }
          },
          "required": [
            "kind",
            "promise_id",
            "resolution"
          ],
          "type": "object"
        },
        {
          "properties": {
            "holder_workflow_id": {
              "description": "Workflow id of the session that emitted the invocation — the\nendpoint a receiver signals its reply to. Supplied by the\nsubstrate adapter; the engine treats it as opaque.",
              "type": "string"
            },
            "invocation": {
              "$ref": "#/definitions/WorkflowToolInvocation"
            },
            "kind": {
              "const": "tool_invocation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "invocation",
            "holder_workflow_id"
          ],
          "type": "object"
        },
        {
          "description": "Best-effort notice to a bound receiver that the session already\nresolved one keyed completion promise as cancelled. The receiver may\nstop the domain work behind that key; a later reply is ignored\nbecause the promise is terminal.",
          "properties": {
            "completion_key": {
              "type": "string"
            },
            "invocation_id": {
              "$ref": "#/definitions/WorkflowToolInvocationId"
            },
            "kind": {
              "const": "invocation_cancellation",
              "type": "string"
            },
            "promise_id": {
              "$ref": "#/definitions/PromiseId"
            }
          },
          "required": [
            "kind",
            "invocation_id",
            "completion_key",
            "promise_id"
          ],
          "type": "object"
        }
      ]
    },
    "EmissionEnvelope": {
      "description": "Bounded cross-workflow fact delivered through the fixed\n`deliver_emission` signal.",
      "properties": {
        "body": {
          "$ref": "#/definitions/EmissionBody"
        },
        "emission_id": {
          "$ref": "#/definitions/EmissionId"
        },
        "producer": {
          "$ref": "#/definitions/EmissionProducer"
        }
      },
      "required": [
        "emission_id",
        "producer",
        "body"
      ],
      "type": "object"
    },
    "EmissionId": {
      "description": "Stable identity for one cross-workflow emission.\n\nIds are deterministic digests over a domain-separated, length-prefixed\nproducer/source identity. They are safe to recompute after activity retry,\nworker restart, or workflow continue-as-new.",
      "type": "string"
    },
    "EmissionProducer": {
      "description": "Durable producer identity carried with every emission.",
      "oneOf": [
        {
          "description": "A session-log-backed emission. `log_seq` is the exact sequence of the\nevent that produced the fact.",
          "properties": {
            "kind": {
              "const": "session",
              "type": "string"
            },
            "log_seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "$ref": "#/definitions/SessionId"
            },
            "universe_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "universe_id",
            "session_id",
            "log_seq"
          ],
          "type": "object"
        },
        {
          "description": "An emission backed by another durable workflow's state.\n`universe_id` scopes this communication edge; it does not imply that\nthe producing workflow itself is universe-owned. A deployment-global\nworkflow may emit independently authorized facts for multiple\nuniverses.",
          "properties": {
            "kind": {
              "const": "workflow",
              "type": "string"
            },
            "universe_id": {
              "format": "uuid",
              "type": "string"
            },
            "workflow_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "universe_id",
            "workflow_id"
          ],
          "type": "object"
        }
      ]
    },
    "MaintainChannelTypingInput": {
      "description": "`maintain_channel_typing`: keep the provider's typing indicator up for\nthe conversation until the activity is cancelled.",
      "properties": {
        "route": {
          "$ref": "#/definitions/ChannelRoute"
        }
      },
      "required": [
        "route"
      ],
      "type": "object"
    },
    "ModelConfig": {
      "properties": {
        "apiKind": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        }
      },
      "required": [
        "providerId",
        "apiKind",
        "model"
      ],
      "type": "object"
    },
    "PrepareChannelMediaInput": {
      "description": "`prepare_channel_media`: the connector downloads the provider file and\nstores it in the universe's CAS.",
      "properties": {
        "media": {
          "$ref": "#/definitions/ChannelInboundMedia"
        },
        "route": {
          "$ref": "#/definitions/ChannelRoute"
        },
        "universeId": {
          "type": "string"
        }
      },
      "required": [
        "universeId",
        "route",
        "media"
      ],
      "type": "object"
    },
    "PrepareChannelMediaResult": {
      "properties": {
        "item": {
          "$ref": "#/definitions/PreparedMediaItem"
        }
      },
      "required": [
        "item"
      ],
      "type": "object"
    },
    "PreparedMediaItem": {
      "description": "A prepared attachment: a CAS reference, never bytes.",
      "properties": {
        "blobRef": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ChannelMediaKind"
        },
        "mime": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "blobRef",
        "kind",
        "mime"
      ],
      "type": "object"
    },
    "PromiseId": {
      "description": "Stable identifier for a promise: a session-scoped counter rendered as\n`promise_<n>`, the same convention as `run_<n>`, so the model copies a\nshort handle rather than a digest. The engine hands every tool batch a\nbase one past the session cursor (`ToolInvocationBatchRequest::\npromise_id_base`); the executor numbers the promises it creates from\nthat base, and the reducer accepts a creation only at or above the\nbatch's base and never twice. Producer correlation lives on\n`PromiseSource`, not in the id.",
      "type": "string"
    },
    "PromiseResolution": {
      "description": "How a promise reached a terminal state. Used by `ResolvePromise`\nadmission; all transports (push notifications, poll results, timers,\ncancellation) converge on this one funnel.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "resolved",
              "type": "string"
            },
            "payload_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ReplyContext": {
      "description": "The message a send replies to, for providers that quote it themselves.",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "senderId",
        "text"
      ],
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "active",
        "parked",
        "cancelling",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "SessionId": {
      "type": "string"
    },
    "ToolCallId": {
      "type": "string"
    },
    "TranscriptionActivityResult": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "succeeded",
              "type": "string"
            },
            "transcript_ref": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "transcript_ref"
          ],
          "type": "object"
        },
        {
          "properties": {
            "failure": {
              "$ref": "#/definitions/TranscriptionFailure"
            },
            "kind": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "failure"
          ],
          "type": "object"
        }
      ]
    },
    "TranscriptionAudio": {
      "additionalProperties": false,
      "description": "Immutable audio input in this universe's content store.",
      "properties": {
        "blobRef": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "blobRef",
        "mime",
        "name"
      ],
      "type": "object"
    },
    "TranscriptionFailure": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/TranscriptionFailureKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "TranscriptionFailureKind": {
      "enum": [
        "invalidAudio",
        "configuration",
        "provider",
        "timeout",
        "internal"
      ],
      "type": "string"
    },
    "TranscriptionSnapshot": {
      "properties": {
        "request": {
          "$ref": "#/definitions/TranscriptionStartParams"
        },
        "view": {
          "$ref": "#/definitions/TranscriptionView"
        }
      },
      "required": [
        "request",
        "view"
      ],
      "type": "object"
    },
    "TranscriptionStartParams": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/definitions/TranscriptionAudio"
        },
        "idempotencyKey": {
          "description": "Scoped to the requester. Matching retries rejoin the original job,\nincluding after defaults change; changed requests conflict. Identity is\nretained for the Temporal namespace's workflow-history retention period.",
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "idempotencyKey",
        "audio"
      ],
      "type": "object"
    },
    "TranscriptionStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ],
      "type": "string"
    },
    "TranscriptionView": {
      "properties": {
        "audio": {
          "$ref": "#/definitions/TranscriptionAudio"
        },
        "createdAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "createdBy": {
          "$ref": "#/definitions/Attribution"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/definitions/TranscriptionFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
