{
  "name": "@lightspeed-ai/sdk",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "TypeScript SDK for the Lightspeed API and workflow integrations.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "default": "./dist/workflow.js"
    },
    "./schema/api.schema.json": "./schema/api.schema.json",
    "./schema/workflow.schema.json": "./schema/workflow.schema.json",
    "./schema/workflow.json": "./schema/workflow.json",
    "./release.json": "./release.json"
  },
  "files": [
    "dist",
    "examples",
    "src",
    "README.md",
    "release.json",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "generate": "node scripts/generate.mjs",
    "check:generated": "npm run generate && git diff --exit-code -- src/generated schema",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run check:generated && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
