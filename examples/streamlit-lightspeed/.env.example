LIGHTSPEED_API_URL=http://127.0.0.1:18080/rpc
LIGHTSPEED_API_KEY=
# URL of the Lightspeed web app opened by the sidebar link. Blank hides it.
LIGHTSPEED_DEMO_PLATFORM_URL=http://127.0.0.1:5173/app/
# Set only for a deployment key. Universe keys already select a universe.
LIGHTSPEED_UNIVERSE=
# Optional. New chat sessions use this profile when set.
LIGHTSPEED_PROFILE_ID=

# Optional dev-only readers. Set a blank address to hide Temporal history.
LIGHTSPEED_DEMO_TEMPORAL_ADDRESS=127.0.0.1:7233
LIGHTSPEED_DEMO_TEMPORAL_NAMESPACE=default
LIGHTSPEED_DEMO_TEMPORAL_UI=http://127.0.0.1:8233
LIGHTSPEED_DEMO_POSTGRES_DSN=
