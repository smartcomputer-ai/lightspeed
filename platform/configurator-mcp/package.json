{
  "name": "@lightspeed-ai/configurator-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Streamable HTTP MCP facade over the universe-scoped Lightspeed API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lightspeed-configurator-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src/generated/tools.ts",
    "tool-filter.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate-tools.mjs",
    "check:generated": "npm run generate && git diff --exit-code -- src/generated/tools.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check": "npm run check:generated && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@lightspeed-ai/sdk": "file:../../clients/typescript",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
