{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "paths": {
      "@/*": ["./src/*"],
      "@distribution/*": ["../../distributions/standard/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.host.config.ts",
    "../../modules/*/components/**/*.ts",
    "../../modules/*/components/**/*.tsx",
    "../../modules/*/demo/**/*.ts",
    "../../modules/*/web/**/*.ts",
    "../../modules/*/web/**/*.tsx",
    "../../distributions/standard/web.ts",
    "../../distributions/standard/main.ts",
    "../../distributions/standard/demo-main.ts",
    "../../distributions/standard/test/web"
  ]
}
