{
  "name": "@lightspeed-ai/platform-web",
  "private": true,
  "type": "module",
  "exports": {
    "./demo": "./src/demo/module-api.ts",
    "./demo/bots": "./src/demo/bot-runtime.ts",
    "./shell": "./src/shell.tsx",
    "./modules": "./src/module-api/index.ts",
    "./modules/blobs": "./src/module-api/blobs.ts",
    "./modules/client": "./src/module-api/client.ts",
    "./modules/dictation": "./src/module-api/dictation.ts",
    "./modules/environments": "./src/module-api/environments.ts",
    "./modules/models": "./src/module-api/models.ts",
    "./modules/profiles": "./src/module-api/profiles.ts",
    "./modules/settings": "./src/module-api/settings.ts",
    "./modules/ui": "./src/module-api/ui.ts",
    "./modules/ui/*": "./src/components/ui/*.tsx",
    "./modules/ui/icons": "./src/icons/index.ts",
    "./modules/ui/lists": "./src/module-api/lists.ts",
    "./modules/ui/meta": "./src/module-api/meta.ts",
    "./modules/ui/status": "./src/module-api/status.ts",
    "./modules/workspaces": "./src/module-api/workspaces.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "test:host": "vitest run --config vitest.host.config.ts",
    "test:modules": "playwright test -c playwright.config.ts modules.pw.ts",
    "screenshots:demo": "node scripts/screendiff.mjs capture",
    "screendiff:demo": "node scripts/screendiff.mjs diff",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lightspeed-ai/platform-shared": "*",
    "@lightspeed-ai/sdk": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "extendable-media-recorder": "^9.2.40",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "screendiff-js": "^0.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
