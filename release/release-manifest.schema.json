{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightspeed.dev/schemas/release-manifest-v1.json",
  "title": "Lightspeed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "version",
    "gitSha",
    "rustVersion",
    "target",
    "envdTarget",
    "envdTargets",
    "envdBinaries",
    "envdBuilds",
    "buildImage",
    "protocolVersion",
    "envdProtocolVersion",
    "controllerProtocolVersion",
    "contractRevision",
    "schemaRevision",
    "platformSchemaRevision",
    "platformUpgradeFrom",
    "images",
    "binaries",
    "artifacts",
    "typescriptClient"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rustVersion": { "type": "string", "minLength": 1 },
    "target": { "const": "x86_64-unknown-linux-gnu" },
    "envdTarget": { "type": "string", "pattern": "-linux-musl$" },
    "envdTargets": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+(-[a-z0-9_]+)+$" }
    },
    "envdBinaries": {
      "type": "object", "minProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/binaryArtifact" }
    },
    "envdBuilds": {
      "type": "object", "additionalProperties": false,
      "required": ["x86_64-unknown-linux-musl", "x86_64-pc-windows-msvc"],
      "properties": {
        "x86_64-unknown-linux-musl": {
          "type": "object", "additionalProperties": false,
          "required": ["buildImage", "rustVersion"],
          "properties": {
            "buildImage": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
            "rustVersion": { "type": "string", "minLength": 1 }
          }
        },
        "x86_64-pc-windows-msvc": { "$ref": "#/$defs/windowsBuild" }
      }
    },
    "buildImage": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "envdProtocolVersion": { "type": "integer", "minimum": 1 },
    "controllerProtocolVersion": { "type": "integer", "minimum": 1 },
    "contractRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schemaRevision": { "type": "integer", "minimum": 1 },
    "platformSchemaRevision": { "type": "integer", "minimum": 1 },
    "platformUpgradeFrom": { "type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+$" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "configuratorMcp",
        "platform",
        "platformWorkers"
      ],
      "properties": {
        "runtime": { "$ref": "#/$defs/imageReference" },
        "configuratorMcp": { "$ref": "#/$defs/imageReference" },
        "platform": { "$ref": "#/$defs/imageReference" },
        "platformWorkers": { "$ref": "#/$defs/imageReference" }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "providerIncus", "envd", "cli"],
      "properties": {
        "runtime": { "$ref": "#/$defs/binaryArtifact" },
        "providerIncus": { "$ref": "#/$defs/binaryArtifact" },
        "envd": { "$ref": "#/$defs/binaryArtifact" },
        "cli": { "$ref": "#/$defs/binaryArtifact" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demo", "docs"],
      "properties": {
        "demo": {
          "type": "object",
          "$ref": "#/$defs/staticArtifact",
          "properties": { "basePath": { "const": "/demo/" } }
        },
        "docs": {
          "type": "object",
          "$ref": "#/$defs/staticArtifact",
          "properties": { "basePath": { "const": "/docs/" } }
        }
      }
    },
    "typescriptClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "const": "@lightspeed-ai/sdk" },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "windowsBuild": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "gitSha", "target", "protocolVersion", "file", "sha256",
        "rustVersion", "cargoVersion", "cargoLockSha256", "osVersion", "msvcVersion",
        "windowsSdkVersion", "linkerVersion", "rustFlags"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "target": { "const": "x86_64-pc-windows-msvc" },
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cargoLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rustVersion": { "type": "string", "minLength": 1 },
        "cargoVersion": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "msvcVersion": { "type": "string", "minLength": 1 },
        "windowsSdkVersion": { "type": "string", "minLength": 1 },
        "linkerVersion": { "type": "string", "minLength": 1 },
        "rustFlags": { "const": "-C target-feature=+crt-static" }
      }
    },
    "imageReference": {
      "type": ["string", "null"],
      "pattern": "@sha256:[0-9a-f]{64}$"
    },
    "binaryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "staticArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "sha256", "basePath"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "basePath": { "enum": ["/demo/", "/docs/"] }
      }
    }
  }
}
