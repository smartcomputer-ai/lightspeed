# Release inputs shared by local packaging and CI. Image references are pinned
# by digest so rebuilding a source commit cannot silently change its toolchain.
LIGHTSPEED_RELEASE_TARGET=x86_64-unknown-linux-gnu
# The environment daemon alone is published as a static binary so it runs on
# any Linux image regardless of its glibc.
LIGHTSPEED_ENVD_TARGET=x86_64-unknown-linux-musl
LIGHTSPEED_PRODUCT_VERSION=0.2.0
LIGHTSPEED_RELEASE_RUST_VERSION=1.97.1
LIGHTSPEED_RELEASE_BUILD_BASE_IMAGE=rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
LIGHTSPEED_API_PROTOCOL_VERSION=lightspeed.agent.api.v1
# The environment protocol number the gateway and envd must agree on exactly;
# a change here is the release event that stops older daemons from registering.
LIGHTSPEED_ENVIRONMENT_PROTOCOL_VERSION=2
LIGHTSPEED_SCHEMA_REVISION=10
# Drizzle journal length and the oldest platform migration boundary accepted by
# the current release's automated upgrade gate.
LIGHTSPEED_PLATFORM_SCHEMA_REVISION=1
LIGHTSPEED_PLATFORM_UPGRADE_FROM=0000_platform_baseline
