# Copy this file to .env. Set at least one provider key for provider-backed
# agent runs; the local infrastructure and UI can start without either key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway auth mode: single (default), trusted-header, or api-key.
# See README "Multi-Tenancy".
#LIGHTSPEED_AUTH_MODE=single
#LIGHTSPEED_UNIVERSE_AUTO_CREATE=false
# Client-side credentials for the CLI/bridge against multi-tenant gateways:
#LIGHTSPEED_API_KEY=lsk_...
#LIGHTSPEED_UNIVERSE=00000000-0000-0000-0000-000000000001
# CAS blob cache budget in bytes per process (0 disables; default 256MiB).
#LIGHTSPEED_BLOB_CACHE_BYTES=268435456
# Allow runtime startup with externally managed Lightspeed tables that have no
# schema_migrations ledger. The built-in migrator remains disabled for them.
#LIGHTSPEED_ALLOW_UNLEDGERED_SCHEMA=false
