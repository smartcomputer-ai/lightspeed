# Copy this file to .env. Configure provider credentials per universe for
# provider-backed agent runs. ./dev.sh configures private local RPC tokens.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway auth mode: single (development) or authenticated.
# See docs/documentation/access-and-security/api-keys-and-service-access.md.
#LIGHTSPEED_AUTH_MODE=single
# For manual authenticated startup, configure at least one runtime token:
#LIGHTSPEED_RPC_TOKEN_FILE=/run/secrets/runtime-token
# The Platform backend must receive a matching token:
#LIGHTSPEED_PLATFORM_RPC_TOKEN_FILE=/run/secrets/runtime-token
# Direct CLI connections name their universe explicitly:
#LIGHTSPEED_UNIVERSE=00000000-0000-0000-0000-000000000001
# CAS blob cache budget in bytes per process (0 disables; default 256MiB).
#LIGHTSPEED_BLOB_CACHE_BYTES=268435456
# Allow runtime startup with externally managed Lightspeed tables that have no
# schema_migrations ledger. The built-in migrator remains disabled for them.
#LIGHTSPEED_ALLOW_UNLEDGERED_SCHEMA=false
